FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY=:1
ENV RESOLUTION=1920x1080

RUN apt-get update && apt-get install -y --no-install-recommends \
    ubuntu-standard iproute2 \
    sudo ca-certificates curl wget gnupg git jq tree htop procps lsof net-tools \
    xvfb x11vnc novnc websockify \
    xfce4 xfce4-goodies xfce4-terminal xfce4-taskmanager thunar mousepad \
    dbus-x11 x11-xserver-utils x11-utils xdotool wmctrl \
    python3 python3-pip python3-venv build-essential cmake nano vim tmux \
    fonts-ubuntu fonts-dejavu fonts-liberation fonts-noto adwaita-icon-theme dmz-cursor-theme \
    libasound2 libgbm1 libnspr4 libnss3 xdg-utils libxkbfile1 libsecret-1-0 libxss1 \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends software-properties-common xdg-user-dirs wget && \
    ARCH="$(dpkg --print-architecture)" && \
    wget -q -O google-chrome.deb "https://dl.google.com/linux/direct/google-chrome-stable_current_${ARCH}.deb" && \
    apt-get install -y ./google-chrome.deb && \
    rm google-chrome.deb && \
    rm -rf /var/lib/apt/lists/* && \
    mv /usr/bin/google-chrome /usr/bin/google-chrome-orig && \
    echo '#!/bin/bash\nexec /usr/bin/google-chrome-orig --no-sandbox --disable-dev-shm-usage "$@"' > /usr/bin/google-chrome && \
    chmod +x /usr/bin/google-chrome

RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

RUN ARCH="$(dpkg --print-architecture)" && \
    if [ "${ARCH}" = "arm64" ]; then \
      curl -fsSL -o /tmp/code.deb "https://update.code.visualstudio.com/latest/linux-deb-arm64/stable"; \
    else \
      curl -fsSL -o /tmp/code.deb "https://update.code.visualstudio.com/latest/linux-deb-x64/stable"; \
    fi && \
    dpkg -i /tmp/code.deb || apt-get install -f -y && \
    rm -f /tmp/code.deb && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --break-system-packages pyautogui playwright selenium opencv-python pillow || true

RUN useradd -m -s /bin/bash -u 1000 abc && \
    echo "abc ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/abc && \
    chmod 0440 /etc/sudoers.d/abc

RUN ln -sf /usr/share/novnc/vnc_lite.html /usr/share/novnc/index.html

COPY cloud-desktop-init.sh /start.sh
RUN chmod +x /start.sh

EXPOSE 3000

CMD ["/start.sh"]
